---
import { getEntry, render } from 'astro:content';

import BackToHomeLink from '@/components/BackToHomeLink.astro';
import PageLayout from '@/layouts/PageLayout.astro';

interface Props {
  /** `src/content/docs/` 配下のエントリ ID */
  entryId: string;
}

const { entryId } = Astro.props;

const entry = await getEntry('docs', entryId);
if (!entry) throw new Error(`docs コレクションに '${entryId}' がありません`);

const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} subtitle={entry.data.subtitle} description={entry.data.description}>
  <div class="doc-content">
    <Content />
    <BackToHomeLink />
  </div>
</PageLayout>
