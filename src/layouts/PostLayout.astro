---
import type { ImageMetadata } from 'astro';

import BackToHomeLink from '@/components/BackToHomeLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatPostDate, toDateTimeAttribute } from '@/utils/date';

interface Props {
  title: string;
  /** news / event / session / sponsors */
  category: string;
  date: Date;
  tags?: string[];
  time?: string;
  description?: string;
  ogImage?: ImageMetadata | string;
}

const { title, category, date, tags = [], time, description, ogImage } = Astro.props;

const showDate = category === 'news';
const showTags = category === 'workshop' || category === 'session';
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="post-head">
    <h2>{category.toUpperCase()}</h2>
  </div>

  <article class="post">
    <h1 class="post-title" set:html={title} />

    {
      showDate && (
        <p class="post-date">
          <time datetime={toDateTimeAttribute(date)}>{formatPostDate(date)}</time>
        </p>
      )
    }

    {
      showTags && (
        <>
          {tags.length > 0 && (
            <p class="tags">
              {tags.map((tag) => (
                <span class="tag-post">{tag}</span>
              ))}
            </p>
          )}
          {time && <p class="post-time">{time}</p>}
        </>
      )
    }

    <div class="post-content">
      <slot />
      <BackToHomeLink />
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  .post-head {
    padding: var(--header-height) 0;

    h2 {
      margin: 0;
      font-size: 2.5rem;
      font-weight: 700;
    }
  }

  .post {
    margin-bottom: 12vh;
    padding: 0 1rem;
    text-align: left;
  }

  .post-title {
    font-size: 2rem;
    text-align: center;
  }

  .post-date,
  .post-time {
    text-align: center;
  }

  .tags {
    text-align: center;
  }

  .tag-post {
    display: inline-block;
    margin: 6px;
    padding: 4px 24px;
    border-radius: 1em;
    background-color: var(--color-light-gray);
  }

  @media screen and (max-width: 640px) {
    .post {
      padding: 0 1em;
    }
  }
</style>
