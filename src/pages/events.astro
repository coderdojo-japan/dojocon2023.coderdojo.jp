---
import { getCollection } from 'astro:content';

import BackToHomeLink from '@/components/BackToHomeLink.astro';
import Icon from '@/components/Icon.astro';
import SmartImage from '@/components/SmartImage.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { resolveImage } from '@/utils/images';

const events = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
const fallbackImage = resolveImage('/images/dummy.jpg');
---

<PageLayout title="EVENT" subtitle="イベント" wide>
  {
    events.length === 0 ? (
      <p class="wait-for-a-moment">まもなくご案内します</p>
    ) : (
      <div class="event-grid">
        {events.map(({ data }) => {
          const image = resolveImage(data.img) ?? fallbackImage;
          return (
            <article class="event">
              <h2 class="ws-title">{data.title}</h2>

              <p class="event-meta">
                {data.time}
                {data.tag && <span class="badge badge-ws">{data.tag}</span>}
              </p>

              {image && (
                <div class="event-image">
                  {data.url ? (
                    <a href={data.url}>
                      <SmartImage src={image} alt={data.title} />
                    </a>
                  ) : (
                    <SmartImage src={image} alt={data.title} />
                  )}
                </div>
              )}

              <p>{data.text}</p>

              {data.url && (
                <p>
                  <a class="btn btn-main" href={data.url}>
                    <Icon name="scroll" /> 詳細を見る
                  </a>
                </p>
              )}
            </article>
          );
        })}
      </div>
    )
  }

  <BackToHomeLink />
</PageLayout>

<style lang="scss">
  .event-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: left;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.75rem 0;
  }

  .event-image {
    margin-bottom: 20px;

    :global(img) {
      width: 100%;
      height: auto;
    }
  }

  @media screen and (max-width: 800px) {
    .event-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
